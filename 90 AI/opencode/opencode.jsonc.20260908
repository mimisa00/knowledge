{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    // 無界限的檔案系統掃描會讓 session 靜默卡死(bash tool 沒有預設 timeout),
    // 且 /proc/registry* 在 MINGW64 底下是整個 Windows 登錄檔,find / 實質上跑不完。
    // 規則是「最後一條匹配的勝出」,所以 catch-all "*" 必須放在最前面。
    // 註:這是安全帶不是牆(cd / && find . 之類繞得過去),主要規範在 AGENTS.md「Shell 約定」。
    "bash": {
      "*": "allow",
      "find / *": "deny",
      "find ~*": "deny",
      "find $HOME*": "deny",
      "* find / *": "deny",
      "* find ~*": "deny",
      "* find $HOME*": "deny"
    },
    // external_directory 是與 read/edit/bash 平行的獨立閘門,管的是「碰到專案根目錄外的路徑」。
    // 判定基準是 worktree 而非 HOME,所以以 root 跑時 ~/ 一律算外部(專案在 /home/fusion-ap/ 底下),
    // 不設就落回預設值 ask,無人值守流程會被權限框卡住。搬動專案位置解決不了,只能在這裡開。
    // 同樣是「最後一條匹配的勝出」,catch-all "*" 放最前面;留 ask 以保住寫到專案外的攔截。
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/etc/**": "allow",
      "/usr/**": "allow",
      "/root/.config/opencode/**": "allow",
      "/root/.m2/**": "allow",
      "/root/.ssh/**": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "grep": "allow",
    "glob": "allow",
    "skill": "allow",
    "question": "allow",
    "playwright_*": "deny",
    "context7_*": "deny"
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@latest",
    "@tarquinen/opencode-dcp@latest",
    "@kdcokenny/opencode-worktree",
    //"oh-my-openagent@latest"
  ],
  "model": "llama/Qwen3.8-27B",
